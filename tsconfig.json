{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The client modules import by `.ts` path, which Node needs to run them with types stripped.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "worker-configuration.d.ts"],
  // The page runs in a browser, and tsconfig.page.json compiles it with the DOM's types.
  "exclude": ["src/page"]
}
