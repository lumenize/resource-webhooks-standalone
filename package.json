{
  "name": "resource-webhooks-standalone",
  "version": "0.0.0",
  "private": true,
  "description": "A prototype MCP extension: subscribe to a resource and hear about its changes by webhook",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run check:schema && vitest run",
    "type-check": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars false",
    "generate:schema": "node scripts/generate-schemas.mjs",
    "check:schema": "node scripts/generate-schemas.mjs --check"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "typescript": "5.9.3",
    "typescript-json-schema": "0.65.1",
    "vitest": "4.1.10",
    "wrangler": "4.147.0"
  }
}
